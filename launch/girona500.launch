<launch>
  <!-- Configurable arguments -->
  <arg name="robot_name" default="girona500"/>
  <arg name="enable_keyboard" default="true"/>
  <arg name="enable_joystick" default="false"/>
  <arg name="joystick_device" default="/dev/input/js0"/>
  <arg name="enable_gui" default="true"/>
  <arg name="enable_rviz" default="true"/>
  <arg name="robot_xacro" default="$(find girona500_description)/urdf/payload.urdf.xacro"/>
    
  <include file="$(find cola2_girona500)/launch/sim_start.launch">
      <arg name="robot_name" value="$(arg robot_name)"/>
      <arg name="robot_xacro" value="$(arg robot_xacro)"/>
  </include>

  <node name="vertical_inspector" pkg="tandem" type="vertical_inspector.py" output="screen">

    <param name="inspection_width" value="8.0" />
    <param name="inspection_depth" value="20.0" />
    <param name="step_down_z" value="2.0" />

    <param name="odom_topic" value="/girona500/odometry" />
    <param name="depth_topic" value="/girona500/navigation/depth" />
    <param name="use_pressure_depth" value="false" />

    <param name="kp_y" value="0.25" />
    <param name="kp_z" value="0.5" />
    <param name="ki_z" value="0.1" />

    <param name="vy_max" value="0.3" />
    <param name="vz_max" value="0.5" />
    <param name="tol_y" value="0.5" />
    <param name="tol_z" value="0.5" />

</node>
 
  <!-- RViz -->
  <node if="$(arg enable_rviz)" pkg="rviz" type="rviz" name="rviz" args="-d $(find cola2_girona500)/scene/girona500.rviz"/>
</launch>
